---
/**
 * Google Tag Manager. Renders ONLY when the site is indexable (launch) AND a container ID
 * is set (PUBLIC_GTM_ID env var in Vercel Production), so preview traffic never reaches
 * client analytics. Never hard-code a real container ID in this template.
 */
import { SITE } from '../config/site';
import { INDEXABLE } from '../lib/indexable';
interface Props { part: 'head' | 'body' }
const { part } = Astro.props;
const id = SITE.gtmId;
const on = INDEXABLE && /^GTM-[A-Z0-9]+$/.test(id);
const headJs = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${id}');`;
---
{on && part === 'head' && <script is:inline set:html={headJs} />}
{on && part === 'body' && (
  <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${id}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
)}
