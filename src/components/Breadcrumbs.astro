---
import { withPolicy } from '../lib/urls';
interface Props { crumbs: { name: string; path: string }[] }
const { crumbs } = Astro.props;
---
<nav class="breadcrumbs container" aria-label="Breadcrumb">
  <ol>
    {crumbs.map((c, i) => (
      <li>{i < crumbs.length - 1 ? <a href={withPolicy(c.path)}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
    ))}
  </ol>
</nav>
